# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
BACKEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres123@localhost:5433/english_golpo?schema=public"
POSTGRES_PASSWORD=postgres123

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-me-in-production-minimum-32-chars!!
JWT_EXPIRES_IN=30d

# ─── OTP (Dev: hardcoded 1234) ────────────────────────────────────────────────
OTP_MOCK_ENABLED=true
OTP_MOCK_CODE=1234
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ─── bKash (Sandbox) ──────────────────────────────────────────────────────────
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_GRANT_TOKEN_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout/token/grant
BKASH_CREATE_PAYMENT_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout/create
BKASH_EXECUTE_PAYMENT_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout/execute

# ─── Nagad ────────────────────────────────────────────────────────────────────
NAGAD_BASE_URL=https://api.mynagad.com/api/dfs
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_MERCHANT_PUBLIC_KEY=

# ─── RevenueCat ───────────────────────────────────────────────────────────────
REVENUECAT_WEBHOOK_SECRET=

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=
